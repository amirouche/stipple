# DOTS LLM provider configuration.
#
# DOTS is provider-neutral: the routing / memory / pack layers never know which
# model answers. Pick one provider with LLM_PROVIDER and supply only that
# provider's key — the others can stay blank. Keys are read server-side only
# (TanStack Start server functions) and never reach the client bundle.
#
# Copy this file to `.env` and fill in the key for your chosen provider.

# Active provider: gemini | openai | claude | grok   (default: gemini)
LLM_PROVIDER=gemini

# API keys — only the selected provider's key is required.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# Optional: override the active provider's model (otherwise a sensible default
# is used per provider — gemini-2.5-flash / gpt-4o-mini / claude-haiku-4-5 /
# grok-2-latest).
# LLM_MODEL=
